# Gemini — required for: npm.cmd run translate
GEMINI_API_KEY=your_key_here

# Optional: rotate across keys on 429 quota errors
# GEMINI_API_KEYS=key1,key2

# Optional: limit a run (comma-separated). Omit both for a full translate.
# TRANSLATE_LOCALES=es,pt,fr,de,it,ar,ja,ko
# TRANSLATE_KINDS=blog,i18n,seo,product,forum
