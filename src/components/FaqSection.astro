---
import type { SiteFaqItem, FaqTopic } from '../data/faq';
import SectionHeader from './SectionHeader.astro';
import FaqAccordionList from './FaqAccordionList.astro';
import { getLocaleFromAstro, getTranslations } from '../i18n';

interface Props {
  items: SiteFaqItem[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  titleId?: string;
  showFilters?: boolean;
  filterTopics?: FaqTopic[];
  centered?: boolean;
  contentAlign?: 'left' | 'center';
  id?: string;
  class?: string;
  /** @deprecated All FAQs use the site accordion; ignored. */
  useNativeDetails?: boolean;
}

const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const faqUi = t.faq;
const filterTopicLabels = (faqUi as { filterTopics?: Record<FaqTopic, string> }).filterTopics;

const {
  items,
  eyebrow = faqUi.eyebrow,
  title = faqUi.title,
  subtitle = faqUi.subtitle,
  titleId = 'faq-heading',
  showFilters = false,
  filterTopics,
  centered = false,
  contentAlign = 'center',
  id: sectionId,
} = Astro.props;

const defaultTopicLabels: Record<FaqTopic, string> = {
  all: 'All',
  plans: 'Plans',
  esp: 'Menu / overlays',
  scripts: 'Scripts',
  safety: 'Safety',
  products: 'Products',
  blog: 'Blog',
  setup: 'Setup',
};

const topicLabels: Record<FaqTopic, string> = { ...defaultTopicLabels, ...filterTopicLabels };

const filters = filterTopics ?? (['all', 'plans', 'safety', 'products', 'setup'] as FaqTopic[]);
const listId = sectionId ? `${sectionId}-accordion` : titleId;
---

<section
  id={sectionId}
  class:list={['py-16 md:py-24', Astro.props.class]}
  aria-labelledby={titleId}
  data-faq-section={showFilters ? '' : undefined}
>
  <div class="mx-auto max-w-6xl px-5">
    <div class:list={[contentAlign === 'center' && 'mx-auto max-w-3xl', contentAlign === 'left' && 'product-detail__narrow max-w-3xl']}>
      <SectionHeader eyebrow={eyebrow} title={title} desc={subtitle} titleId={titleId} centered={centered} />

      {
        showFilters && (
          <div
            class:list={[
              'mt-8 flex flex-wrap gap-2',
              contentAlign === 'center' ? 'justify-center' : 'justify-start',
            ]}
            data-faq-filters
          >
            {filters.map((topic, i) => (
              <button
                type="button"
                class:list={[
                  'faq-filter-chip rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary hover:text-foreground',
                  { 'is-active': i === 0 },
                ]}
                data-faq-filter={topic}
              >
                {topicLabels[topic]}
              </button>
            ))}
          </div>
        )
      }

      <div class="mt-8 w-full" data-faq-list>
        <FaqAccordionList items={items} idPrefix={listId} listClass="w-full" />
      </div>
    </div>
  </div>
</section>
