---
import { getLocaleFromAstro, getTranslations } from '../../i18n';
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';

interface Props {
  product: ProductPage;
  pageH1?: string;
  variant?: 'default' | 'shop';
}

const { product, pageH1, variant = 'default' } = Astro.props;
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
const productUi = (t as { productUi?: Record<string, string> }).productUi ?? {};
const heading = pageH1 ?? product.title;
const isShop = variant === 'shop';
---

<header class:list={['product-detail-header space-y-4', isShop && 'product-detail-header--shop']}>
  <div class="flex flex-wrap items-center gap-2">
    <Badge variant="secondary">{product.badge}</Badge>
    {product.variant === 'popular' && <Badge>{productUi.popularBadge}</Badge>}
    {product.variant === 'limited' && <Badge variant="warning">{productUi.limitedBadge}</Badge>}
    <Badge variant="outline">{productUi.gameBadge}</Badge>
    <Badge variant="outline">{productUi.platformBadge}</Badge>
    {
      isShop && (
        <>
          <Badge variant="outline" class="gap-1.5">
            <Icon name="zap" size={14} aria-hidden="true" />
            {productUi.shopInstantDelivery ?? 'Instant delivery'}
          </Badge>
          <Badge variant="outline" class="gap-1.5">
            <Icon name="shieldCheck" size={14} aria-hidden="true" />
            {productUi.shopPortalDelivery ?? 'Portal delivery'}
          </Badge>
        </>
      )
    }
  </div>
  <h1
    class:list={[
      'font-bold normal-case leading-tight',
      isShop ? 'text-3xl md:text-[2.35rem]' : 'max-w-3xl text-3xl md:text-4xl',
    ]}
  >
    {heading}
  </h1>
  <p
    class:list={[
      'text-lg leading-relaxed text-muted-foreground',
      !isShop && 'max-w-2xl',
      isShop && 'max-w-xl',
    ]}
  >
    {product.subtitle || product.desc}
  </p>
</header>
