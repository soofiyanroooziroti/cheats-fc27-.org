---
import { getLocaleFromAstro, getTranslations } from '../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import '../styles/product-cheat-page.css';
import { getProductPages } from '../data/products';
import { cheatTierIcons, productCategoryIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import { productPath } from '../utils/path';

const productPages = getProductPages(locale);
const s = t.products;
const pc = (t as { productCatalog?: Record<string, string> }).productCatalog ?? {};

const HOME_PRODUCT_SLUGS = ['loader', 'hwid-spoofer'] as const;
const FEATURE_PREVIEW_COUNT = 4;

const homeProducts = HOME_PRODUCT_SLUGS.map((slug) => productPages.find((p) => p.slug === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

function cardIcon(product: (typeof homeProducts)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'gamepad2';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof homeProducts)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}

function buyLabelFor(slug: string) {
  if (slug === 'hwid-spoofer') return pc.buyHwidSpoofer ?? 'Buy the HWID spoofer';
  return pc.buyLoader ?? 'Buy the loader';
}
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />

    <div class="products-section__grid">
      {
        homeProducts.map((product) => (
          <CatalogCard
            class="catalog-card--carousel h-full"
            label={cardLabel(product)}
            title={product.title}
            href={productPath(product.slug, locale)}
            buyUrl={product.buyUrl}
            productSlug={product.slug}
            features={product.features}
            more={product.more}
            icon={cardIcon(product)}
            badge={product.badge}
            variant={product.variant}
            featured={product.slug === 'loader'}
            buyLabel={buyLabelFor(product.slug)}
            maxFeatures={FEATURE_PREVIEW_COUNT}
          />
        ))
      }
    </div>
  </div>
</section>
