---
import { getLocaleFromAstro, getTranslations } from '../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../config/seo';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.about;
const aboutH1 =
  locale === 'en'
    ? 'About this store: cheatsfc27.org sells on Windows PC — portal delivery, pricing, and risk'
    : content.title;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: aboutH1,
      description: seo.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: t.footer.about, path: '/about/' },
    ]),
  ]}
>
  <LegalPage
    title={aboutH1}
    description={content.description}
    breadcrumbLabel={t.footer.about}
    sections={content.sections}
  />
</BaseLayout>
